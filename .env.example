# Подключение к Postgres.
# На Vercel переменная POSTGRES_URL создаётся автоматически при добавлении
# Vercel Postgres (Storage → Create Database). Локально задайте DATABASE_URL.
DATABASE_URL=postgres://postgres@localhost:5432/northstar

# Секрет для защиты /api/check от посторонних вызовов.
# Задайте одинаковое значение в переменных окружения Vercel и во внешнем
# cron-сервисе (заголовок x-northstar-token). Если пусто — проверка открыта всем.
NORTHSTAR_CHECK_TOKEN=

# Telegram-бот (уведомления о релизе + Mini App). Если пусто — бот выключен.
# TELEGRAM_BOT_TOKEN — токен из @BotFather.
# TELEGRAM_WEBHOOK_SECRET — любая случайная строка, проверяется на входящем webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
